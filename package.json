{
  "name": "zhiyu-learning-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --config vite.config.ts --host 127.0.0.1",
    "db:local": "node scripts/db-local.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build --config vite.config.ts",
    "test": "pnpm test:deployment && pnpm test:backend && pnpm test:ui",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "test:ui": "vitest run --config vitest.config.ts",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^30.0.1",
    "typescript": "latest",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  }
}
